{
  "name": "@mycode/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Local memory and bounded, evidence-driven workflows for the mycode OpenCode fork",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/plugin.ts",
    "./server": "./src/plugin.ts"
  },
